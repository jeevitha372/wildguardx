# ---------------------------------------------------------------------------
# WildGuardX demo simulator configuration
#
# These configure MockProvider, the PLACEHOLDER data layer. They have no effect
# once a real Firebase/MQTT ingest is wired in (see src/data/MockProvider.ts).
#
# Every value below can also be supplied as:
#   - a prop on `new MockProvider({ ... })`
#   - a URL query param, e.g. ?demo-interval=3000&demo-offline-nodes=12
# Precedence: URL query > constructor props > env > built-in default.
# ---------------------------------------------------------------------------

# Milliseconds between simulated detections. Default: 12000
VITE_DEMO_INTERVAL=12000

# Severity mix for generated detections, as `name:weight` pairs.
# Weights are normalised, so they need not sum to 1.
# Default: critical:0.12,warning:0.28,watch:0.40,info:0.20
VITE_DEMO_SEVERITY_MIX=critical:0.12,warning:0.28,watch:0.40,info:0.20

# How many of the 291 nodes report offline. Default: 3
VITE_DEMO_OFFLINE_NODES=3

# How many nodes report degraded. Default: 4
VITE_DEMO_DEGRADED_NODES=4

# Deterministic seed for the fixture generator + simulator. Default: 20260817
VITE_DEMO_SEED=20260817

# Probability (0..1) that a generated critical detection also raises the
# 15-second SOS takeover. Default: 0.35
VITE_DEMO_SOS_CHANCE=0.35

# Simulated network latency in ms, applied to every provider call so loading
# skeletons are actually observable. Default: 420
VITE_DEMO_LATENCY=420

# ---------------------------------------------------------------------------
# Theme
# ---------------------------------------------------------------------------
# Fallback theme when the visitor has no stored preference AND their OS
# expresses no prefers-color-scheme. Values: dark | light. Default: dark
#
# Resolution order is localStorage -> prefers-color-scheme -> this -> dark.
# It is read by the inline bootstrap in index.html (so there is no flash of the
# wrong theme) and by src/lib/useTheme.ts.
VITE_DEFAULT_THEME=dark
